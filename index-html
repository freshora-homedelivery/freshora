*{box-sizing:border-box}html,body{margin:0}
body{background:var(--bg);color:var(--ink);font:400 16px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;padding:env(safe-area-inset-top,0) 0 96px}
h1,h2{font-family:"Trebuchet MS",system-ui,sans-serif;letter-spacing:-.02em;margin:0}
.wrap{max-width:680px;margin:0 auto;padding:0 16px}
header{padding:26px 0 14px}h1{font-size:clamp(34px,10vw,50px);line-height:1;font-weight:800;color:var(--leaf)}
header p{color:var(--mute);margin:8px 0 0}
.rules{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:16px 0 6px}
