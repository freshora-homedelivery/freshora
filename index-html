.fast button{background:#2e7d32;color:#fff;border:0;border-radius:99px;padding:9px 18px;font-weight:700;cursor:pointer}
.back{border:0;background:var(--chip);color:var(--ink);width:40px;height:40px;border-radius:50%;font-size:20px;cursor:pointer}
.ctop{display:flex;align-items:center;gap:14px;padding:18px 0 8px}.ctop h1{font-size:24px;color:var(--ink);flex:1;text-align:center;margin-right:40px}
.nav a.on span{background:var(--leaf);border-radius:12px;width:44px;margin:0 auto 2px;padding:2px 0;filter:none}
.emo img{width:100%;height:100%;object-fit:cover;border-radius:14px}.cat img{width:46px;height:46px;object-fit:cover;border-radius:12px}
.ann{background:#fff3cd;color:#5c4400;text-align:center;padding:8px 12px;font-weight:600;font-size:14px;position:sticky;top:0;z-index:15}
.bn{display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;margin:12px 0}.bnr{min-width:100%;scroll-snap-align:start;color:#fff;min-height:150px;margin:0}.bnr p{margin:0 0 12px}
</style></head><body>
<div class="wrap"><div id="ann" class="ann" hidden></div>
<section data-v="welcome" hidden><div class="sp-top"><h1>Freshora</h1><p>Fresh • Local • Fast</p><div class="sp-art" aria-hidden="true">🧺<small>🍅🥬🫑</small></div></div>
