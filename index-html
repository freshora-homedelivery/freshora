.track{list-style:none;padding:0;margin:14px 0}.track li{padding:10px 0 10px 34px;position:relative;color:var(--mute)}
.track li:before{content:"";position:absolute;left:6px;top:14px;width:16px;height:16px;border-radius:50%;border:2px solid var(--line);background:var(--surface)}
.track li.on{color:var(--ink);font-weight:700}.track li.on:before{background:var(--leaf);border-color:var(--leaf)}
.big{font-size:56px;text-align:center}.center{text-align:center}
body{padding-bottom:84px}.bar{display:none!important}

:root{--leaf:#2e7d32}
section[data-v=welcome]{position:fixed;inset:0;z-index:50;flex-direction:column;background:linear-gradient(160deg,#3f9a3f,#1b5e20)}
section[data-v=welcome]:not([hidden]){display:flex}
.sp-top{flex:1;text-align:center;color:#fff;padding:calc(36px + env(safe-area-inset-top,0)) 20px 0;position:relative;overflow:hidden}
.sp-top h1{color:#fff;font-size:46px}.sp-top p{margin:2px 0 0;opacity:.9;letter-spacing:.04em}
.sp-art{font-size:92px;line-height:1.1;margin-top:18px}.sp-art small{display:block;font-size:46px;letter-spacing:10px}
.sp-bot{background:var(--surface);border-radius:36px 36px 0 0;padding:26px 22px calc(24px + env(safe-area-inset-bottom,0));text-align:center}
.sp-bot h2{font-size:28px}.sp-bot p{color:var(--mute);margin:8px 0 18px}
.top{display:flex;align-items:center;gap:10px;padding:18px 0 8px}.top b{display:block;font-size:17px}
.pin{font-size:26px}.sbox{display:block;width:100%;background:var(--chip);border:0;border-radius:99px;padding:13px 18px;text-align:left;color:var(--mute);font-size:16px;cursor:pointer;margin:6px 0 4px}
.hero{display:flex;align-items:center;justify-content:space-between;background:linear-gradient(120deg,#2e7d32,#1b5e20);border-radius:20px;padding:18px}
.hero .tag{display:inline-block;background:#b6e34a;color:#14301b;border-radius:99px;font-size:12px;font-weight:800;padding:4px 12px;margin-bottom:8px}
.hero h2{font-size:26px;line-height:1.1;margin-bottom:12px}.hero .art{font-size:62px;line-height:1}
.hero button{background:#fff;color:#1b5e20}
.cats{grid-template-columns:repeat(4,1fr)}.cat{border-radius:16px}
.fast{display:flex;align-items:center;gap:12px;background:#dff2c4;color:#14301b;border-radius:16px;padding:12px 14px;margin:14px 0}
