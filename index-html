var catDocs=[],banners=[],DEFAULT_HERO='<div class="hero bnr"><div><span class="tag">Fresh, local shops</span><h2>Farm Fresh<br>at Your Home</h2><button data-go="cats">Shop Now →</button></div><div class="art" aria-hidden="true">🧺</div></div>';
