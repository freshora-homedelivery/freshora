.nav a span{display:block;font-size:22px}.nav a.on{color:var(--leaf)}
.nav i{font-style:normal;background:var(--hot);color:#fff;border-radius:99px;font-size:11px;padding:0 6px;margin-left:2px}
.pay{display:flex;gap:12px;align-items:center;border:2px solid var(--line);border-radius:14px;padding:14px;margin:10px 0;cursor:pointer;font-weight:600}
